FROM node:20
WORKDIR /app
COPY . .
RUN npm install
ARG VITE_MENU_API_URL
ARG VITE_ORDER_API_URL
ARG VITE_NOTIFY_API_URL
ARG VITE_AUTH_API_URL
ENV VITE_MENU_API_URL=$VITE_MENU_API_URL
ENV VITE_ORDER_API_URL=$VITE_ORDER_API_URL
ENV VITE_NOTIFY_API_URL=$VITE_NOTIFY_API_URL
ENV VITE_AUTH_API_URL=$VITE_AUTH_API_URL
RUN npm run build
EXPOSE 5173
CMD ["npm", "run", "preview", "--", "--host", "0.0.0.0", "--port", "5173"]
