# Optional combined file: copy to `.env` in this folder if you prefer one
# file instead of a `.env` inside each service. Services also read ../.env.
#
# MongoDB URI format:
#   mongodb://[USERNAME:PASSWORD@]HOST:PORT/DATABASE
# Local without auth (default):
MENU_MONGO_URI=mongodb://127.0.0.1:27017/campusbite_menu
ORDER_MONGO_URI=mongodb://127.0.0.1:27017/campusbite_orders
NOTIFY_MONGO_URI=mongodb://127.0.0.1:27017/campusbite_notify
AUTH_MONGO_URI=mongodb://127.0.0.1:27017/campusbite_auth
# With auth, use:
# MENU_MONGO_URI=mongodb://USERNAME:PASSWORD@HOST:PORT/campusbite_menu

MENU_SERVICE_URL=http://127.0.0.1:8001
ORDER_SERVICE_URL=http://127.0.0.1:8002
NOTIFY_SERVICE_URL=http://127.0.0.1:8003
AUTH_SERVICE_URL=http://127.0.0.1:8004

MENU_PORT=8001
ORDER_PORT=8002
NOTIFY_PORT=8003
AUTH_PORT=8004

JWT_SECRET=your-jwt-secret

CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
